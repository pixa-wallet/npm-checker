APP_NAME=PackageProof Pro
ENVIRONMENT=production
DATABASE_URL=sqlite:////app/data/packageproof.db

# Algorand x402 v2 payment
X402_ENABLED=true
X402_NETWORK=testnet
PAY_TO_ADDRESS=YOUR_58_CHARACTER_ALGORAND_ADDRESS
FACILITATOR_URL=https://facilitator.goplausible.xyz
# Optional safety assertion. TestNet=10458941, MainNet=31566704.
# The service derives the correct USDC ASA automatically when left empty.
X402_ASSET_ID=
X402_ASSET_SYMBOL=USDC
X402_ASSET_DECIMALS=6
X402_CHALLENGE_TAG=x402-global-challenge
ANALYZE_PACKAGE_PRICE=$0.05

# E2B sandbox
ENABLE_E2B=true
E2B_API_KEY=e2b_YOUR_KEY
E2B_ALLOW_INTERNET_ACCESS=true
E2B_INSTALL_STRACE=true
E2B_TEMPLATE=
E2B_TIMEOUT_SECONDS=90

# OpenRouter analyst summaries
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Runtime tuning
CACHE_TTL_SECONDS=86400
HTTP_TIMEOUT_SECONDS=15
MAX_ARCHIVE_BYTES=8388608
MAX_STATIC_FILES=250

# Buyer-only variables for scripts/live_x402_paid_check.py. Never deploy these
# to the resource server and never commit a real mnemonic.
ALGORAND_MNEMONIC=
AVM_ADDRESS=
